#!/usr/bin/env bash
set -e -x

cd "${BOSH_INSTALL_TARGET}"
java_tar_file=$(find "${BOSH_COMPILE_TARGET}" -name "bellsoft-*.tar.gz" | sort --version-sort| tail -n1)

mkdir jdk
tar zxvf "${java_tar_file}" -C jdk --strip 1
if [[ $? != 0 ]] ; then
  echo "Cannot unpack JDK"
  exit 1
fi

# Ensure correct permissions
chmod -R a+r jdk

# setup a spring boot directory
cd ${BOSH_INSTALL_TARGET}
mkdir boot
cp -a "${BOSH_COMPILE_TARGET}"/wars/cloudfoundry-identity-uaa.war boot/uaa-boot.war
